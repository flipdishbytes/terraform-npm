{
  "name": "@DoveConviene/terraform_npm",
  "version": "1.0.0",
  "description": "An NPM executable package for HashiCorp's Terraform.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoveConviene/terraform-npm.git"
  },
  "license": "AAL",
  "private": false,
  "os": [
    "!aix"
  ],
  "cpu": [
    "!mips",
    "!mipsel",
    "!ppc",
    "!ppc64",
    "!s390",
    "!s390x"
  ],
  "keywords": [
    "terraform",
    "hashicorp",
    "infrastructure",
    "automation",
    "infrastructure-as-code",
    "executable"
  ],
  "scripts": {
    "start": "cd src && node terraform-wrapper",
    "pub": "npm publish --no-git-tag-version --strict-semver",
    "postinstall": "node src/install-terraform && node src/install-tflint"
  },
  "bin": {
    "terraform": "src/terraform-wrapper.js",
    "tflint": "src/tflint-wrapper.js"
  },
  "dependencies": {
    "progress": "^2.0.0",
    "yauzl": "^2.9.1"
  },
  "devDependencies": {
    "pkgfiles": "^2.3.2",
    "prettier": "^1.12.1"
  },
  "main": "index.js"
}
